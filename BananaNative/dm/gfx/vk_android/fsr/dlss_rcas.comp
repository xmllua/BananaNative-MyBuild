#version 450
#extension GL_GOOGLE_include_directive : require
// NVN2's DLSS stand-in (vka_dlss.c): AMD's RCAS on the output-size work image (FSR 1's EASU or GSR2's scene colour, both tonemapped), then, with pc.itm, the tonemap
// undone (c / (1 - max(c))) back to the linear HDR the game's post chain expects. con0.x is RCAS's sharpness as a linear factor (DM_VK_DLSS_SHARP / 100)
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D tex;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform P { uvec4 con0; ivec2 size; int itm; } pc;
#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_RCAS_F 1
// Clamped: RCAS reads a 3x3 neighbourhood
AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(tex, clamp(p, ASU2(0), ASU2(pc.size) - 1), 0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx_fsr1.h"
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, uvec2(pc.size)))) return;
    AF3 c;
    FsrRcasF(c.r, c.g, c.b, p, pc.con0);
    c = clamp(c, 0.0, 1.0);
    if (pc.itm != 0) c /= max(1.0 - max(c.r, max(c.g, c.b)), 1.0 / 1024.0);
    imageStore(dst, ivec2(p), vec4(c, 1.0));
}
