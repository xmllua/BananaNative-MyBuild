#version 450
#extension GL_GOOGLE_include_directive : require
// FSR 1 RCAS after ndsr_easu.comp (DM_VK_NDSR_SHARP): sharpens the replay's intermediate image into the game's output image, one pixel per invocation. The store: ndsr_out.h
//
// AMD's FsrRcasF (ffx_fsr1.h, 32-bit path, no denoise, no alpha), written out here with its two limiters' reciprocals kept finite. AMD's code takes exact reciprocals
// of 4 * max(ring) and of 4 * min(ring) - 4, which are infinite where the ring is black (0) or white (1): 0 * inf is NaN, and its min / max are meant to drop the NaN
// (HLSL's, and NVIDIA's and AMD's hardware). SPIR-V's FMin / FMax leave a NaN operand undefined, and Qualcomm's driver (Adreno 840) returns the NaN, so every black or
// white neighbourhood came out NaN: Ocarina of Time's fades (whole frames black) and dark corners. With the reciprocals of a value at least 2^-20 away from zero, a
// limiter there is large and finite and the clamp of the lobe to [-limit, 0] takes it as AMD's code does elsewhere (no sharpening at the extremes)
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D tex;
layout(push_constant) uniform P { uvec4 con0, con1, con2, con3; uvec2 size; } pc;
#include "ndsr_out.h"
const float RCAS_LIMIT = 0.25 - 1.0 / 16.0;   // FSR_RCAS_LIMIT
const float TINY = 1.0 / 1048576.0;
// Clamped: RCAS reads a 3x3 neighbourhood, and the replay leaves robustness off, so the edge pixels must not read outside the image
vec3 ld(ivec2 p) { return texelFetch(tex, clamp(p, ivec2(0), textureSize(tex, 0) - 1), 0).rgb; }
float rmax3(float a, float b, float c) { return max(a, max(b, c)); }
void main() {
    uvec2 up = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(up, pc.size))) return;
    ivec2 p = ivec2(up);
    //    b
    //  d e f
    //    h
    vec3 b = ld(p + ivec2(0, -1)), d = ld(p + ivec2(-1, 0)), e = ld(p), f = ld(p + ivec2(1, 0)), h = ld(p + ivec2(0, 1));
    vec3 mn4 = min(min(b, d), min(f, h)), mx4 = max(max(b, d), max(f, h));
    vec3 hitMin = min(mn4, e) / max(4.0 * mx4, vec3(TINY));                       // AMD: min(mn4, e) * rcp(4 * mx4)
    vec3 hitMax = (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, vec3(-TINY));        // AMD: (1 - max(mx4, e)) * rcp(4 * mn4 - 4)
    vec3 lobe3 = max(-hitMin, hitMax);
    float lobe = max(-RCAS_LIMIT, min(rmax3(lobe3.r, lobe3.g, lobe3.b), 0.0)) * uintBitsToFloat(pc.con0.x);
    vec3 c = (lobe * (b + d + h + f) + e) / (4.0 * lobe + 1.0);                   // (4 * lobe + 1 >= 0.25)
    ndsr_store(p, c);
}
