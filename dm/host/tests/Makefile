	$(CLANG) -O1 -Wall -Wno-unused-function -I.. -o $@ t_save_sync_metadata.c
.PHONY: save-sync
save-sync: $(B)/t_save_sync $(B)/t_save_sync_metadata
	TMPDIR="$(abspath $(B))" $(B)/t_save_sync $(QUIET)
	TMPDIR="$(abspath $(B))" $(B)/t_save_sync_metadata $(QUIET)
