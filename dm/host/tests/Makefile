# dm/host unit tests in one command: make -C dm/host/tests GAME=<base game title ID> run (takes seconds; build output goes to build/ and is not committed)
B = build
PYTHON ?= python3
# SAN: extra compiler flags for a sanitizer or coverage build (make asan, make tsan-threads and make coverage below set it, with B = a build folder of their own); empty otherwise
SAN ?=
CLANG = clang $(SAN)
# stderr that the plain run hides is kept in sanitizer builds: the sanitizers report there
QUIET = $(if $(findstring -fsanitize,$(SAN)),,2>/dev/null)
.DEFAULT_GOAL := run
# game profile header (dm.h needs game_profile.h, generated by the host Makefile into ../gen/<profile>/)
# tests that use the game profile need GAME=<base game title ID> (there is no default game); GINC only expands when used, so tests without the profile build as before
GINC = $(if $(strip $(GAME)),-I../gen/$(GAME) -I../../games/$(GAME),$(error GAME is not set: make GAME=<base game title ID>: $(shell python3 ../../games/game.py list | awk -F'\t' '{printf "%s (%s)  ", $$1, $$3}')))
$(B)/t_fs $(B)/t_fs_case $(B)/t_fs_commit_list $(B)/t_fs_commit_list_tsan: ../romfs_image.h
GAME_H = ../gen/$(GAME)/game_profile.h
# hle_movie.c and android/av_android.h ask the Vulkan replay whether the swapchain swaps red and blue (vka_swap_rb, a weak reference the Android host defines); Mach-O links a weak
# reference to an undefined symbol only when it is named as allowed to stay undefined
WEAK_HOST = -Wl,-U,_vka_swap_rb

run: $(B)/t_language $(B)/t_motion $(B)/t_heap_size $(B)/t_touch $(B)/t_gesture $(B)/t_oe $(B)/t_fs $(B)/t_fs_commit_list $(B)/t_thread_leak $(B)/t_fs_case $(B)/t_audio $(B)/t_audio_spsc $(B)/t_swkbd $(B)/t_altstack $(B)/t_condvar $(B)/t_condvar_old $(B)/t_pollwait $(B)/t_pctl $(B)/t_time $(B)/t_shared_font $(B)/t_vorbis $(B)/t_vorbis_divides $(B)/t_hid $(B)/t_haptics $(B)/t_haptics_apple $(B)/t_cheats $(B)/t_pad_hid
	$(B)/t_language
	$(B)/t_heap_size
	$(B)/t_touch
	$(B)/t_gesture
	$(B)/t_oe $(QUIET)
	$(B)/t_fs $(QUIET)
	TMPDIR="$(abspath $(B))" $(B)/t_fs_commit_list
	$(B)/t_thread_leak
	TMPDIR="$(abspath $(B))" $(B)/t_fs_case $(QUIET)
	TMPDIR="$(abspath $(B))" $(B)/t_save_sync $(QUIET)
	TMPDIR="$(abspath $(B))" $(B)/t_save_sync_metadata $(QUIET)
	$(B)/t_audio
	$(B)/t_audio_spsc
	$(B)/t_audio_stats
	$(B)/t_fpslock
	$(B)/t_uecvar
	$(B)/t_audren_work
	$(B)/t_audren_layout
	$(B)/t_swkbd
	$(B)/t_altstack
	$(B)/t_bigstack
	$(B)/t_condvar
	$(B)/t_condvar_old
	$(B)/t_pollwait
	$(B)/t_preempt
	$(B)/t_preempt --all-peers
	$(B)/t_pctl
	$(B)/t_time
	$(B)/t_shared_font
	$(B)/t_system_event
	$(B)/t_vorbis
	$(B)/t_vorbis_divides
	$(B)/t_movie_vpx
	$(B)/t_codec_video
	$(B)/t_movie_avc
	$(B)/t_nv
	$(B)/t_nfc
	$(B)/t_motion
	$(B)/t_motion_apple
	$(B)/t_pad_apple
	$(B)/t_motion_pro
	$(B)/t_motion_pro_mac
	TMPDIR="$(abspath $(B))" $(B)/t_hid
	$(B)/t_pad_hid
	$(B)/t_haptics
	$(B)/t_haptics_apple
	TMPDIR="$(abspath $(B))" $(B)/t_cheats $(QUIET)
	$(B)/t_nro
	$(B)/t_pack_modules
	$(B)/t_symbols
	$(B)/t_android_av
	$(B)/t_android_input
	$(B)/t_android_shlib
	$(B)/t_android_imgmem
	$(B)/t_android_zshare
	$(B)/t_android_texlimit
	$(B)/t_android_livemap
	$(B)/t_android_texown
	$(B)/t_android_mapbudget
	$(B)/t_android_pckeep
	$(B)/t_android_pwlist
	$(B)/t_android_fmtlist
	$(B)/t_android_place
	$(B)/t_android_ovl
	$(B)/t_android_pace
	$(B)/t_android_gmem
	$(B)/t_android_fpenv
	$(B)/t_android_soft
	$(B)/t_android_qsched
	$(B)/t_android_poolslot
	$(B)/t_android_tlsig
	$(B)/t_android_gbar
run: $(B)/t_nro
run: $(B)/t_pack_modules
run: $(B)/t_symbols
$(B)/t_symbols: t_symbols.c ../hle.c ../loader.c ../hle.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -Wno-deprecated-declarations -I.. $(GINC) -o $@ t_symbols.c
.PHONY: symbols
symbols: $(B)/t_symbols
	$(B)/t_symbols
run: $(B)/t_system_event
run: $(B)/t_audren_work
$(B)/t_audren_work: t_audren_work.c ../hle_audren.c ../hle.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_audren_work.c
.PHONY: audren-work
audren-work: $(B)/t_audren_work
	$(B)/t_audren_work
run: $(B)/t_audren_layout
$(B)/t_audren_layout: t_audren_layout.c ../hle_audren.c ../hle.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_audren_layout.c
.PHONY: audren-layout
audren-layout: $(B)/t_audren_layout
	$(B)/t_audren_layout
$(B)/t_system_event: t_system_event.c ../hle_thread.c ../hle_sdk16.c ../hle.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -Wno-frame-address -I.. $(GINC) -o $@ t_system_event.c
.PHONY: system-event
system-event: $(B)/t_system_event
	$(B)/t_system_event
$(B)/t_nro: t_nro.c ../loader.c ../hle_ro.c ../hle.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -g -Wall -Wno-unused-function -Wno-deprecated-declarations -I.. $(GINC) -o $@ t_nro.c
.PHONY: nro
nro: $(B)/t_nro
	$(B)/t_nro
# the cheat engine (hle_cheats.c, compiled into the test with stubs for the loader, the heap and the keys)
$(B)/t_cheats: t_cheats.c ../hle_cheats.c ../dm.h ../dm_input.h $(GAME_H) | $(B)
	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_cheats.c
.PHONY: cheats
cheats: $(B)/t_cheats
	TMPDIR="$(abspath $(B))" $(B)/t_cheats
# Regenerated on every make (FORCE), by the host Makefile: a header from an older game.py lacks newer defines; game.py writes it only when it changes, so an unchanged header rebuilds no test
$(GAME_H): FORCE
	$(MAKE) -C .. game_profile GAME=$(GAME)
$(B)/t_pack_modules: t_pack_modules.c ../pack_modules.h | $(B)
	$(CLANG) -O1 -Wall -Werror -fsanitize=undefined -I.. -o $@ t_pack_modules.c

$(B)/t_heap_size: t_heap_size.c ../hle_svc.c ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -Wall -Werror -Wno-unused-function -fsanitize=undefined -I.. $(GINC) -o $@ t_heap_size.c
.PHONY: heap_size
heap_size: $(B)/t_heap_size
	$(B)/t_heap_size
$(B)/t_touch: t_touch.c ../hle_touch.c ../front.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_touch.c ../hle_touch.c
$(B)/t_gesture: t_gesture.c ../hle_touch.c ../front.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -Wall -Wno-unused-function -I.. $(GINC) -o $@ t_gesture.c ../hle_touch.c
$(B)/t_thread_leak: t_thread_leak.c ../thread.c ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_thread_leak.c
# zstd's decompressor for the NUP container tests (nup_image.h, built with DM_NUP_ZSTD as the Android host is; the Mac host is built without it)
$(B)/zstddec.o: ../../third_party/zstd/zstddeclib.c | $(B)
	$(CLANG) -O2 -w -c -o $@ $<
$(B)/t_fs: t_fs.c t_fs_stub.c ../hle_fs.c ../save_sync.c ../save_sync.h ../hle_bigstack.c ../hle.h ../dm.h ../nup_image.h nup_fixture_zst.h $(B)/zstddec.o $(GAME_H) | $(B)
	$(CLANG) -O1 -Wno-unused-function -DDM_NUP_ZSTD -I.. $(GINC) -o $@ t_fs.c t_fs_stub.c ../hle_bigstack.c ../save_sync.c $(B)/zstddec.o
# Manual check of the NUP reader against a real dump (not in run): build/t_nup_dump <file>.nup:<selector> <RomFS folder>
$(B)/t_nup_dump: t_nup_dump.c t_fs_stub.c ../hle_fs.c ../save_sync.c ../hle_bigstack.c ../nup_image.h ../romfs_image.h $(B)/zstddec.o $(GAME_H) | $(B)
	$(CLANG) -O2 -Wno-unused-function -DDM_NUP_ZSTD -I.. $(GINC) -o $@ t_nup_dump.c t_fs_stub.c ../hle_bigstack.c ../save_sync.c $(B)/zstddec.o
# Inject only the folder handle allocation; directory I/O remains real.
$(B)/t_fs_directory: t_fs_directory.c t_fs_stub.c ../hle_fs.c ../romfs_image.h ../save_sync.c ../save_sync.h ../hle_bigstack.c ../hle.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_fs_directory.c t_fs_stub.c ../hle_bigstack.c ../save_sync.c
.PHONY: fs-directory
fs-directory: $(B)/t_fs_directory
	TMPDIR="$(abspath $(B))" $(B)/t_fs_directory
run: fs-directory
$(B)/t_fs_commit_list: t_fs_commit_list.c t_fs_stub.c ../hle_fs.c ../save_sync.c ../save_sync.h ../hle_bigstack.c ../hle.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -Wall -Wno-unused-function -I.. $(GINC) -o $@ t_fs_commit_list.c t_fs_stub.c ../hle_bigstack.c ../save_sync.c
$(B)/t_fs_commit_list_tsan: t_fs_commit_list.c t_fs_stub.c ../hle_fs.c ../save_sync.c ../save_sync.h ../hle_bigstack.c ../hle.h ../dm.h $(GAME_H) | $(B)
	$(CLANG) -O1 -g -fsanitize=thread -Wall -Wno-unused-function -I.. $(GINC) -o $@ t_fs_commit_list.c t_fs_stub.c ../hle_bigstack.c ../save_sync.c
.PHONY: fs-tsan
fs-tsan: $(B)/t_fs_commit_list_tsan
	TMPDIR="$(abspath $(B))" $(B)/t_fs_commit_list_tsan
