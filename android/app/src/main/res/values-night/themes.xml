<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Banana" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/bn_banana</item>
        <item name="android:colorPrimaryDark">@color/bn_bg</item>
        <item name="android:colorAccent">@color/bn_accent</item>
        <item name="android:colorControlActivated">@color/bn_accent</item>
        <item name="android:colorBackground">@color/bn_bg</item>
        <item name="android:windowBackground">@color/bn_bg</item>
        <item name="android:textColorPrimary">@color/bn_text</item>
        <item name="android:textColorSecondary">@color/bn_text_2</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.Banana.Dialog</item>
    </style>

    <style name="Theme.Banana.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/bn_accent</item>
        <item name="android:colorControlActivated">@color/bn_accent</item>
        <item name="android:colorBackground">@color/bn_card</item>
        <item name="android:textColorPrimary">@color/bn_text</item>
        <item name="android:textColorSecondary">@color/bn_text_2</item>
        <item name="android:windowBackground">@drawable/bn_dialog_bg</item>
        <item name="android:buttonBarButtonStyle">@style/Banana.DialogButton</item>
    </style>

    <style name="Banana.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
